# come2gether-2026-challenge — Konfiguration
#
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# ── bConnect-Ziel ──────────────────────────────────────────
# Mock-Modus (Default): Kein echtes bMS nötig
BCONNECT_BASE_URL=http://bconnect-mock:3433/bconnect
BCONNECT_API_KEY=

# Echtes bMS (auskommentieren und anpassen):
# BCONNECT_BASE_URL=https://bms.example.com:444/bconnect
# BCONNECT_API_KEY=dein-api-key-hier

# ── KI (Workflow 3) ───────────────────────────────────────
# Anthropic API Key für den Claude AI Agent
# Ohne Key funktionieren Workflow 1 und 2 trotzdem.
# Key erstellen: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Host-Ports (nur bei Konflikten anpassen) ──────────────
# Falls ein Port auf deinem Rechner schon belegt ist (z. B. läuft
# bereits ein anderes n8n auf 5678), hier einen freien Host-Port
# setzen — die Container-internen Ports bleiben unverändert.
# N8N_HOST_PORT=5679
# GATEWAY_HOST_PORT=3001
# MOCK_HOST_PORT=3433
