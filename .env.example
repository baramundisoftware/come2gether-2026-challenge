# c2g-2026-challenge — Konfiguration
#
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# ── bConnect-Ziel ──────────────────────────────────────────
# Mock-Modus (Default): Kein echtes bMS nötig
BCONNECT_BASE_URL=http://bconnect-mock:3433/bconnect
BCONNECT_API_KEY=

# Echtes bMS (auskommentieren und anpassen):
# BCONNECT_BASE_URL=https://bms.example.com:444/bconnect
# BCONNECT_API_KEY=dein-api-key-hier

# ── KI (Workflow 3) ───────────────────────────────────────
# Anthropic API Key fuer den Claude AI Agent
# Ohne Key funktionieren Workflow 1 und 2 trotzdem.
# Key erstellen: https://console.anthropic.com/
ANTHROPIC_API_KEY=
